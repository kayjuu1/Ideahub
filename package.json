{
  "name": "Ideahub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "deploy": "bun run --cwd apps/web deploy",
    "db:generate": "bun run --cwd apps/web db:generate",
    "db:migrate:local": "bun run --cwd apps/web db:migrate:local",
    "db:migrate:remote": "bun run --cwd apps/web db:migrate:remote",
    "db:studio": "bun run --cwd apps/web db:studio",
    "cf:types": "bun run --cwd apps/web cf:types",
    "test": "bun run --cwd apps/web test",
    "security:audit": "bun run --cwd apps/web security:audit",
    "seed:admin": "bun run --cwd apps/web seed:admin",
    "setup:local": "bun apps/web/scripts/setup-local.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
