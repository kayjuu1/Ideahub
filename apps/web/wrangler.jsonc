{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideahub",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@ideagap.org"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ideahub-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "ideahub-local-attachments" }
  ],
  "env": {
    "staging": {
      "name": "ideahub-staging",
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@ideagap.org"] }],
      "r2_buckets": [],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "ideahub-staging",
        "database_id": "918289ef-0214-4665-b408-b3f41c087847",
        "migrations_dir": "drizzle",
        "remote": true
      }]
    }
  }
}
