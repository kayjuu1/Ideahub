{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "cf:types": "wrangler types",
    "test": "vitest run",
    "seed:admin": "tsx ../../scripts/seed-admin.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.57",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/router-plugin": "1.168.40",
    "@workspace/ui": "workspace:*",
    "better-auth": "1.7.5",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "drizzle-orm": "0.45.3",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@cloudflare/workers-types": "5.20260921.1",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "miniflare": "5.20260921.0-alpha",
    "seroval": "1.6.7",
    "tsx": "4.23.15",
